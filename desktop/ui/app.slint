import { Slider } from "std-widgets.slint";

// Campo de texto.
//
// Es un `TextInput` a pelo, no el `LineEdit` de los widgets estándar: con
// este se puede pintar el fondo y el borde como el resto de la app, igual
// en todas las plataformas. Con `read-only` el texto se puede seleccionar y
// copiar con el teclado, pero no editar.
component CodeField inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <string> placeholder: "";
    in property <length> font-size: 13px;
    in property <length> letter-spacing: 0px;
    in property <int> font-weight: 400;
    in property <color> text-color: #f4f4f8;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    // Sin fondo ni borde: para incrustar el campo en una pieza propia (la
    // tarjeta del código).
    in property <bool> bare: false;
    // Se dispara al apretar Enter: para conectar escribiendo el código.
    callback accepted();

    // Copia todo el contenido al portapapeles.
    //
    // Slint no tiene una API de portapapeles aparte: la copia la hace el
    // `TextInput` sobre lo que tenga seleccionado. Por eso se selecciona
    // todo, se copia y se limpia la selección (si no, el código queda
    // marcado en azul).
    public function copy-text() {
        input.select-all();
        input.copy();
        input.clear-selection();
    }

    in property <length> field-height: 30px;
    border-radius: 6px;
    height: root.field-height;
    background: root.bare ? #00000000 : #ffffff10;
    border-width: root.bare ? 0px : 1px;
    border-color: input.has-focus ? #7c7cff : #ffffff26;
    clip: true;

    // El texto de ejemplo, mientras no hay nada escrito.
    if root.text == "" && root.placeholder != "": txt := Text {
        x: root.bare ? 0px : 8px;
        y: ((root.height - txt.height) / 2) - 1px;
        text: root.placeholder;
        color: #6f6f7c;
        font-size: root.font-size;
        vertical-alignment: center;
    }

    input := TextInput {
        x: root.bare ? 0px : 8px;
        width: root.bare ? parent.width : parent.width - 16px;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        single-line: true;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        selection-background-color: #7c7cff;
        selection-foreground-color: #ffffff;
        accepted => { root.accepted(); }
    }
}

// Botón con un ícono SVG centrado.
//
// Los íconos se cargan como imágenes (`@image-url`), no como elementos `Path`:
// el renderizador software no dibuja `Path`, pero sí rasteriza SVG con resvg,
// y lo hace al tamaño físico de pantalla (con el scale factor), así que los
// íconos quedan nítidos en pantallas HiDPI.
//
// El color no viene del SVG: se usa `colorize`, que lo trata como máscara
// alfa. Por eso los archivos son blancos y el tinte se define acá.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: #f2f2f6;
    in property <length> icon-size: 22px;
    in property <bool> active: true;
    // El botón es el elegido: lo usa el menú lateral para marcar el panel
    // que se está viendo.
    in property <bool> selected: false;
    // Sin fondo salvo al pasar el mouse: para acciones secundarias (copiar,
    // desconectar) que no deben competir con el resto.
    in property <bool> flat: false;
    // La acción principal del panel: se pinta con el acento, para que
    // compita con el resto de los botones.
    in property <bool> primary: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: root.selected
        ? #7c7cff2e
        : root.primary
        ? (touch.pressed ? #7c7cff5c : (touch.has-hover ? #7c7cff4d : #7c7cff3a))
        : root.flat ? (touch.pressed ? #ffffff1f : (touch.has-hover ? #ffffff10 : transparent))
        : (touch.pressed ? #55555b : (touch.has-hover ? #2d2d2f : #353539));
    opacity: root.active ? 1 : 0.35;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    Image {
        source: root.icon;
        colorize: root.tint;
        image-fit: contain;
        width: root.icon-size;
        height: root.icon-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Fila: punto de estado + código + botón copiar. Se reusa en ambas vistas de
// Conexión (unión y conectados).
component CodeCopyRow inherits HorizontalLayout {
    in-out property <string> text;
    in property <bool> read-only: true;
    in property <string> placeholder: "";
    in property <length> row-height: 30px;
    in property <length> font-size: 13px;
    in property <int> font-weight: 500;
    in property <length> letter-spacing: 0.5px;
    in property <bool> show-dot: true;
    in property <bool> can-send: false;
    callback copied();

    spacing: 1px;
    cross-axis-alignment: center;

    if root.show-dot: VerticalLayout {
        padding-right: 4px;
        Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: root.can-send ? #6ee7a8 : #5c5c66;
        }
    }

    code := CodeField {
        horizontal-stretch: 1;
        field-height: root.row-height;
        text <=> root.text;
        read-only: root.read-only;
        bare: true;
        placeholder: root.placeholder;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
    }

    IconButton {
        icon: @image-url("../assets/icons/content_copy.svg");
        icon-size: 13px;
        width: 22px;
        height: 22px;
        flat: true;
        border-radius: 5px;
        clicked => { code.copy-text(); root.copied(); }
    }
}

// Una sesión de medios que se puede elegir.
//
// El `id` es con lo que el backend la reconoce (el nombre de bus de D-Bus en
// Linux, el identificador de la aplicación en Windows). El `label` es lo que
// se ve en el chip, y lleva un sufijo cuando hay varias sesiones con el mismo
// nombre.
export struct MediaSession {
    id: string,
    label: string,
}

// Chip de una sesión de medios: el nombre del reproductor, y un clic para
// elegir a cuál controlar.
component SessionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 17px;
    border-radius: 8px;
    background: root.selected ? #ffffff20 : #ffffff0a;

    // El chip se ajusta al texto. El `Text` va directo (no en un layout) para
    // que su ancho sea el natural y no dependa del chip: si no, el ancho del
    // chip y el de su contenido se cyclan.
    txt := Text {
        text: root.label;
        color: root.selected ? #f4f4f8 : #7d7d89;
        font-size: 11px;
        x: 7px;
        y: ((root.height - txt.height) / 2) - 1px;
    }

    width: txt.width + 14px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Un panel del área central, con la animación de entrada.
//
// Slint no anima un elemento que se acaba de crear, así que los tres paneles
// existen siempre y lo único que cambia es cuál está visible. Para que la
// animación corra, el contenido arranca abajo y transparente y recién en el
// cuadro siguiente se le pide que suba: el cambio de valor es lo que dispara
// el `animate`.
component PanelSlot inherits Rectangle {
    in property <bool> active: false;
    in-out property <bool> revealed: false;

    // Solo el panel activo existe para el mouse: los otros dos no
    // interceptan clics ni el teclado.
    visible: root.active;
    clip: true;

    content := Rectangle {
        width: parent.width;
        height: parent.height;
        y: root.revealed ? 0px : 12px;
        opacity: root.revealed ? 1 : 0;
        animate y {
            duration: 250ms;
            easing: ease-out;
        }
        animate opacity {
            duration: 250ms;
            easing: ease-out;
        }

        @children
    }

    // Un cuadro de espera: es el que deja el panel ya visible, abajo y
    // transparente, antes de animarlo a su lugar. No consulta nada, solo
    // destraba la animación.
    Timer {
        interval: 16ms;
        running: root.active && !root.revealed;
        triggered => { root.revealed = true; }
    }

    changed active => {
        if !root.active {
            root.revealed = false;
        }
    }
}

// La ventana de la app.
//
// A la izquierda el panel activo; a la derecha el menú con los tres paneles
// (Controles, Conexión y Configuración). Los tres comparten el mismo ancho y
// alto, así que la ventana no cambia de tamaño al cambiar de panel y el
// compositor no tiene que re-anclarla.
//
// Una sola ventana a propósito: en Wayland no se puede "mostrar" una
// ventana después de crearla (winit no puede mapear una superficie que ya
// existe), así que una segunda ventana Slint solo aparecería si se muestra
// antes de que arranque el event loop.
export component AppWindow inherits Window {
    title: "sincronin-controlin";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // La ventana es compacta por defecto. Controles es el único panel que
    // necesita el ancho grande; Conexión y Configuración comparten los
    // 155 px (112 de contenido + 42 de menú + 1 de separador).
    // El círculo del modo discreto: la ventana entera, achicada y sin la
    // interfaz, para no tapar lo que se está viendo a pantalla completa.
    width: root.collapsed ? 44px : (root.active-panel == 0 ? 420px : 155px);
    height: root.collapsed ? 44px : 112px;

    // El tamaño que quiere la ventana. En Windows lo usa el backend para
    // reanclar la ventana abajo al centro cuando cambia el ancho.
    out property <length> wanted-width: root.width;
    out property <length> wanted-height: root.height;

    in-out property <string> track-title: "Esperando al reproductor…";
    in-out property <string> track-artist: "";
    in-out property <bool> playing: false;
    in-out property <bool> has-session: false;
    in-out property <bool> can-toggle: true;
    in-out property <bool> can-seek: true;
    in-out property <int> position-secs: 0;
    in-out property <int> duration-secs: 0;

    // Las sesiones de medios disponibles y cuál se está controlando. Con una
    // sola (o ninguna), el selector no se muestra.
    in property <[MediaSession]> sessions;
    in property <int> session-count: 0;
    in property <string> session-id: "";

    // El código de sala de este cliente.
    in property <string> room-code: "";
    // El código de sala del otro equipo: lo escribe el usuario.
    in-out property <string> peer-room: "";
    // El estado de la conexión.
    in property <string> state-text: "Desconectado";
    // El rol en la sala: Anfitrión (comparte su reproducción) o Invitado.
    in property <string> role-text: "";
    // Si el canal de datos está abierto, se puede mandar.
    in property <bool> can-send: false;
    // Cuántas personas hay en la sala, contando a esta.
    // Uno o cero es la vista de unión; más de uno, la vista conectada.
    in property <int> room-count: 0;
    // Los avisos y mensajes que publica la red. Ningún panel los muestra
    // todavía: se guardan para cuando haya un lugar donde leerlos.
    in property <string> log-text: "";

    // Qué panel se ve: 0 = Controles, 1 = Conexión, 2 = Configuración.
    // Arranca en Conexión para que el código de sala esté disponible desde
    // el inicio, sin ocupar el ancho de Controles.
    in-out property <int> active-panel: 1;

    callback toggle-play-pause();
    callback seek-backward();
    callback seek-forward();
    callback seek-to(float);
    callback select-session(string);
    callback connect(string);
    callback disconnect();
    // Cambió el panel visible: el adaptador entra a la sala propia al abrir
    // Conexión, para que el código que muestra esté vivo.
    callback panel-changed(int);
    // Cambió el ancho de la ventana (o sea, el panel activo): el backend de
    // plataforma la vuelve a anclar.
    callback size-changed();
    // El puntero entró o salió de la ventana: la app reinicia la cuenta de
    // inactividad, que es una regla del dominio.
    callback pointer-entered();
    callback pointer-left();

    // El mouse está sobre la ventana. Lo publica el sensor; mientras esté
    // encima, la ventana no se achica.
    property <bool> pointer-inside: sensor.has-hover;
    // La ventana está achicada al círculo del modo discreto.
    in-out property <bool> collapsed: false;

    sensor := TouchArea {
        width: 100%;
        height: 100%;

        // La interfaz de siempre. Se oculta al achicarse al círculo.
        Rectangle {
            visible: !root.collapsed;
            width: 100%;
            height: 100%;
            border-radius: 14px;
            background: @linear-gradient(180deg, #202020, #090909);
            border-width: 1px;
            border-color: #ffffff18;

            // Toda la ventana se puede arrastrar. Los controles se declaran
            // después, así que quedan por encima y siguen recibiendo sus clics
            // con normalidad.
            WindowMoveArea { }

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0;

                // El área central: los tres paneles se apilan en el mismo lugar
                // y `PanelSlot` deja visible solo el que está activo.
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    // ── Controles ──
                    PanelSlot {
                        active: root.active-panel == 0;

                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                // Título y artista: la mitad izquierda de la fila.
                                VerticalLayout {
                                    width: 50%;
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: root.track-title;
                                        color: root.has-session ? #f4f4f8 : #8d8d99;
                                        font-size: 14px;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.track-artist;
                                        color: #9a9aa6;
                                        font-size: 11px;
                                        overflow: elide;
                                    }

                                    // Selector de sesión: solo aparece cuando hay
                                    // más de una.
                                    if root.session-count > 1: HorizontalLayout {
                                        horizontal-stretch: 0;
                                        spacing: 5px;
                                        padding-top: 5px;

                                        for session in root.sessions: SessionChip {
                                            label: session.label;
                                            selected: session.id == root.session-id;
                                            clicked => { root.select-session(session.id); }
                                        }
                                    }
                                }

                                // Los controles, pegados al borde derecho.
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 4px;

                                    IconButton {
                                        icon: @image-url("../assets/icons/replay_10.svg");
                                        active: root.has-session && root.can-seek;
                                        clicked => { root.seek-backward(); }
                                    }

                                    IconButton {
                                        icon: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play_arrow.svg");
                                        active: root.has-session && root.can-toggle;
                                        clicked => { root.toggle-play-pause(); }
                                    }

                                    IconButton {
                                        icon: @image-url("../assets/icons/forward_10.svg");
                                        active: root.has-session && root.can-seek;
                                        clicked => { root.seek-forward(); }
                                    }
                                }
                            }

                            // Línea de progreso: un slider para buscar posición, a
                            // lo ancho completo del panel.
                            Slider {
                                width: 100%;
                                height: 22px;
                                minimum: 0.0;
                                maximum: root.duration-secs * 1.0;
                                value: root.position-secs * 1.0;
                                enabled: root.has-session && root.can-seek;
                                released => { root.seek-to(self.value); }
                            }
                        }
                    }

                    // ── Conexión: vista de unión ──
                    //
                    // Cuando estoy solo: tu código arriba, la entrada para unirte a
                    // la sala del otro abajo, separadas por una línea sutil en vez
                    // de la "o" que ocupaba una fila entera.
                    PanelSlot {
                        active: root.active-panel == 1 && root.room-count <= 1;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 10px;
                            alignment: center;

                            // Tu código (con su punto de estado y copiar).
                            CodeCopyRow {
                                horizontal-stretch: 1;
                                text: root.room-code;
                                read-only: true;
                                row-height: 30px;
                                font-size: 12px;
                                font-weight: 500;
                                letter-spacing: 0.5px;
                                show-dot: true;
                                can-send: root.can-send;
                            }

                            // Divisor sutil entre "tu código" y "unirte".
                            Rectangle {
                                width: 100%;
                                height: 1px;
                                background: #ffffff14;
                            }

                            // Unirse a otra sala: se escribe el código y se
                            // conecta, con el botón o con Enter.
                            HorizontalLayout {
                                spacing: 6px;
                                cross-axis-alignment: center;

                                CodeField {
                                    horizontal-stretch: 1;
                                    height: 24px;
                                    text <=> root.peer-room;
                                    placeholder: "código";
                                    font-size: 12px;
                                    accepted => { root.connect(root.peer-room); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/link.svg");
                                    icon-size: 14px;
                                    tint: #dcdcff;
                                    width: 24px;
                                    height: 24px;
                                    primary: true;
                                    border-radius: 5px;
                                    clicked => { root.connect(root.peer-room); }
                                }
                            }
                        }
                    }

                    // ── Conexión: vista conectada ──
                    //
                    // Con otra persona en la sala: la misma fila de la sala, el
                    // rol con el botón de desconectar al costado y las órbitas,
                    // una por persona.
                    PanelSlot {
                        active: root.active-panel == 1 && root.room-count > 1;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 6px;
                                cross-axis-alignment: center;
                                padding-left: 2px;

                                CodeCopyRow {
                                    horizontal-stretch: 1;
                                    text: root.room-code;
                                    read-only: true;
                                    row-height: 24px;
                                    font-size: 12px;
                                    font-weight: 500;
                                    letter-spacing: 0.5px;
                                    show-dot: true;
                                    can-send: root.can-send;
                                }
                            }

                            // Una órbita por persona de la sala, incluido uno mismo.
                            // `animation-tick` es el reloj de animación de Slint,
                            // no un timer que consulte nada: la órbita gira con el
                            // cuadro. Una vuelta cada 8 s para que se mueva muy
                            // suave, sin temblor.
                            HorizontalLayout {
                                alignment: center;
                                spacing: 0;

                                orbit := Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    property <length> radius: 13px;
                                    property <angle> spin: 1turn * (animation-tick() / 12s);

                                    for i in root.room-count: Rectangle {
                                        property <angle> phase: orbit.spin + 1turn * (i * 1.0 / root.room-count);
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: #7c7cff33;
                                        opacity: 1;
                                        x: (parent.width - self.width) / 2 + orbit.radius * Math.cos(phase);
                                        y: (parent.height - self.height) / 2 + orbit.radius * Math.sin(phase);

                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            background: #a9a9ff;
                                        }
                                    }
                                }
                            }

                            // Quién sos en la sala, con el botón de desconectar
                            // justo debajo de las órbitas.
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: root.role-text;
                                    color: #8d8d99;
                                    font-size: 9px;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/logout.svg");
                                    icon-size: 12px;
                                    width: 20px;
                                    height: 20px;
                                    flat: true;
                                    border-radius: 5px;
                                    clicked => { root.disconnect(); }
                                }
                            }
                        }
                    }

                    // ── Configuración (reservado) ──
                    PanelSlot {
                        active: root.active-panel == 2;
                    }
                }

                // La línea que separa el panel del menú.
                Rectangle {
                    width: 1px;
                    background: #ffffff14;
                }

                // El menú lateral: tres botones de ícono, apilados y del mismo
                // tamaño.
                //
                // El ancho es el de un botón (30) más su relleno: 42. Con el
                // ancho que tenía la columna, los botones quedaban pegados a la
                // izquierda y sobraba aire a la derecha.
                Rectangle {
                    width: 42px;

                    // Tres botones de 30 px: con 112 px de alto, tres de 34 más
                    // la separación no entran.
                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 6px;
                        spacing: 4px;
                        alignment: center;

                        IconButton {
                            icon: @image-url("../assets/icons/link.svg");
                            icon-size: 17px;
                            width: 30px;
                            height: 30px;
                            selected: root.active-panel == 1;
                            tint: root.active-panel == 1 ? #a9a9ff : #f2f2f6;
                            clicked => { root.active-panel = 1; }
                        }

                        IconButton {
                            icon: @image-url("../assets/icons/tune.svg");
                            icon-size: 17px;
                            width: 30px;
                            height: 30px;
                            selected: root.active-panel == 0;
                            tint: root.active-panel == 0 ? #a9a9ff : #f2f2f6;
                            clicked => { root.active-panel = 0; }
                        }

                        IconButton {
                            icon: @image-url("../assets/icons/settings.svg");
                            icon-size: 17px;
                            width: 30px;
                            height: 30px;
                            selected: root.active-panel == 2;
                            tint: root.active-panel == 2 ? #a9a9ff : #f2f2f6;
                            clicked => { root.active-panel = 2; }
                        }
                    }
                }
            }
        }

        // El círculo: la misma ventana, sin la interfaz.
        //
        // El fondo translúcido deja ver lo que hay detrás y la opacidad
        // atendúa también el borde y el ícono, así el círculo se nota sin
        // tapar la reproducción.
        Rectangle {
            visible: root.collapsed;
            width: 100%;
            height: 100%;
            border-radius: 22px;
            opacity: 0.35;
            background: #101014cc;
            border-width: 1px;
            border-color: #ffffff22;

            Image {
                source: @image-url("../assets/icons/link.svg");
                colorize: #a9a9ff;
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    changed pointer-inside => {
        if root.pointer-inside {
            root.pointer-entered();
        } else {
            root.pointer-left();
        }
    }

    changed active-panel => { root.panel-changed(root.active-panel); }
    changed width => { root.size-changed(); }
}
