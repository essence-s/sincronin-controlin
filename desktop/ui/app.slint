import { Slider } from "std-widgets.slint";

// Campo de texto.
//
// Es un `TextInput` a pelo, no el `LineEdit` de los widgets estándar: con
// este se puede pintar el fondo y el borde como el resto de la app, igual
// en todas las plataformas. Con `read-only` el texto se puede seleccionar y
// copiar con el teclado, pero no editar.
component CodeField inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <string> placeholder: "";
    in property <length> font-size: 13px;
    in property <color> text-color: #f4f4f8;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    // Se dispara al apretar Enter: para conectar escribiendo el código.
    callback accepted();

    // Copia todo el contenido al portapapeles.
    //
    // Slint no tiene una API de portapapeles aparte: la copia la hace el
    // `TextInput` sobre lo que tenga seleccionado. Por eso se selecciona
    // todo, se copia y se limpia la selección (si no, el código queda
    // marcado en azul).
    public function copy-text() {
        input.select-all();
        input.copy();
        input.clear-selection();
    }

    height: 30px;
    border-radius: 6px;
    background: #ffffff10;
    border-width: 1px;
    border-color: input.has-focus ? #7c7cff : #ffffff26;
    clip: true;

    // El texto de ejemplo, mientras no hay nada escrito.
    if root.text == "" && root.placeholder != "": Text {
        x: 10px;
        text: root.placeholder;
        color: #6f6f7c;
        font-size: root.font-size;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        single-line: true;
        color: root.text-color;
        font-size: root.font-size;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        selection-background-color: #7c7cff;
        selection-foreground-color: #ffffff;
        accepted => { root.accepted(); }
    }
}

// Botón con un ícono SVG centrado.
//
// Los íconos se cargan como imágenes (`@image-url`), no como elementos `Path`:
// el renderizador software no dibuja `Path`, pero sí rasteriza SVG con resvg,
// y lo hace al tamaño físico de pantalla (con el scale factor), así que los
// íconos quedan nítidos en pantallas HiDPI.
//
// El color no viene del SVG: se usa `colorize`, que lo trata como máscara
// alfa. Por eso los archivos son blancos y el tinte se define acá.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: #f2f2f6;
    in property <length> icon-size: 22px;
    in property <bool> active: true;
    // El botón es el elegido: lo usa el menú lateral para marcar el panel
    // que se está viendo.
    in property <bool> selected: false;
    // Sin fondo salvo al pasar el mouse: para acciones secundarias (copiar,
    // desconectar) que no deben competir con el resto.
    in property <bool> flat: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: root.selected
        ? #7c7cff2e
        : root.flat ? (touch.pressed ? #ffffff1f : (touch.has-hover ? #ffffff10 : transparent))
        : (touch.pressed ? #55555b : (touch.has-hover ? #2d2d2f : #353539));
    opacity: root.active ? 1 : 0.35;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    Image {
        source: root.icon;
        colorize: root.tint;
        image-fit: contain;
        width: root.icon-size;
        height: root.icon-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Botón con texto, para las acciones que conviene leer (Conectar).
//
// El botón se ajusta al texto: el `Text` va directo (no en un layout) para
// que su ancho sea el natural y no dependa del botón. Un `Rectangle` en un
// layout no tiene ancho propio y se invisible.
component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: true;
    callback clicked();

    height: 30px;
    border-radius: 8px;
    background: touch.pressed ? #4d4d56 : (touch.has-hover ? #3a3a41 : #2c2c32);
    opacity: root.active ? 1 : 0.4;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    txt := Text {
        text: root.label;
        color: #ececf3;
        font-size: 12px;
        x: 12px;
        y: (root.height - txt.height) / 2;
    }

    width: txt.width + 24px;
}

// Una sesión de medios que se puede elegir.
//
// El `id` es con lo que el backend la reconoce (el nombre de bus de D-Bus en
// Linux, el identificador de la aplicación en Windows). El `label` es lo que
// se ve en el chip, y lleva un sufijo cuando hay varias sesiones con el mismo
// nombre.
export struct MediaSession {
    id: string,
    label: string,
}

// Chip de una sesión de medios: el nombre del reproductor, y un clic para
// elegir a cuál controlar.
component SessionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 17px;
    border-radius: 8px;
    background: root.selected ? #ffffff20 : #ffffff0a;

    // El chip se ajusta al texto. El `Text` va directo (no en un layout) para
    // que su ancho sea el natural y no dependa del chip: si no, el ancho del
    // chip y el de su contenido se cyclan.
    txt := Text {
        text: root.label;
        color: root.selected ? #f4f4f8 : #7d7d89;
        font-size: 11px;
        x: 7px;
        y: (root.height - txt.height) / 2;
    }

    width: txt.width + 14px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Un panel del área central, con la animación de entrada.
//
// Slint no anima un elemento que se acaba de crear, así que los tres paneles
// existen siempre y lo único que cambia es cuál está visible. Para que la
// animación corra, el contenido arranca abajo y transparente y recién en el
// cuadro siguiente se le pide que suba: el cambio de valor es lo que dispara
// el `animate`.
component PanelSlot inherits Rectangle {
    in property <bool> active: false;
    in-out property <bool> revealed: false;

    // Solo el panel activo existe para el mouse: los otros dos no
    // interceptan clics ni el teclado.
    visible: root.active;
    clip: true;

    content := Rectangle {
        width: parent.width;
        height: parent.height;
        y: root.revealed ? 0px : 12px;
        opacity: root.revealed ? 1 : 0;
        animate y { duration: 250ms; easing: ease-out; }
        animate opacity { duration: 250ms; easing: ease-out; }

        @children
    }

    // Un cuadro de espera: es el que deja el panel ya visible, abajo y
    // transparente, antes de animarlo a su lugar. No consulta nada, solo
    // destraba la animación.
    Timer {
        interval: 16ms;
        running: root.active && !root.revealed;
        triggered => { root.revealed = true; }
    }

    changed active => {
        if !root.active {
            root.revealed = false;
        }
    }
}

// La ventana de la app.
//
// A la izquierda el panel activo; a la derecha el menú con los tres paneles
// (Controles, Conexión y Configuración). Los tres comparten el mismo ancho y
// alto, así que la ventana no cambia de tamaño al cambiar de panel y el
// compositor no tiene que re-anclarla.
//
// Una sola ventana a propósito: en Wayland no se puede "mostrar" una
// ventana después de crearla (winit no puede mapear una superficie que ya
// existe), así que una segunda ventana Slint solo aparecería si se muestra
// antes de que arranque el event loop.
export component AppWindow inherits Window {
    title: "sincronin-controlin";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // El tamaño no cambia nunca: los tres paneles miden lo mismo.
    width: 420px;
    height: 112px;

    // El alto que quiere la ventana. En Windows lo usa el backend para
    // anclar la ventana abajo.
    out property <length> wanted-height: root.height;

    in-out property <string> track-title: "Esperando al reproductor…";
    in-out property <string> track-artist: "";
    in-out property <bool> playing: false;
    in-out property <bool> has-session: false;
    in-out property <bool> can-toggle: true;
    in-out property <bool> can-seek: true;
    in-out property <int> position-secs: 0;
    in-out property <int> duration-secs: 0;

    // Las sesiones de medios disponibles y cuál se está controlando. Con una
    // sola (o ninguna), el selector no se muestra.
    in property <[MediaSession]> sessions;
    in property <int> session-count: 0;
    in property <string> session-id: "";

    // El código de sala de este cliente.
    in property <string> room-code: "";
    // El código de sala del otro equipo: lo escribe el usuario.
    in-out property <string> peer-room: "";
    // El estado de la conexión.
    in property <string> state-text: "Desconectado";
    // El rol en la sala: Anfitrión (comparte su reproducción) o Invitado.
    in property <string> role-text: "";
    // Si el canal de datos está abierto, se puede mandar.
    in property <bool> can-send: false;
    // Los avisos y mensajes que publica la red. Ningún panel los muestra
    // todavía: se guardan para cuando haya un lugar donde leerlos.
    in property <string> log-text: "";

    // Qué panel se ve: 0 = Controles, 1 = Conexión, 2 = Configuración.
    in-out property <int> active-panel: 0;

    // La línea de estado del panel de Conexión. Con el canal abierto se ve a
    // qué sala se está conectado y con qué rol ("Conectado a 5F73R6
    // (invitado)"); si no, el estado que publica la red.
    pure function status-line() -> string {
        if !root.can-send {
            return root.state-text;
        }
        if root.role-text == "" {
            return "Conectado a " + root.room-code;
        }
        return "Conectado a " + root.room-code + " (" + root.role-text.to-lowercase() + ")";
    }

    property <string> status-text: status-line();

    callback toggle-play-pause();
    callback seek-backward();
    callback seek-forward();
    callback seek-to(float);
    callback select-session(string);
    callback connect(string);
    callback disconnect();
    // Cambió el panel visible: el adaptador entra a la sala propia al abrir
    // Conexión, para que el código que muestra esté vivo.
    callback panel-changed(int);

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        background: @linear-gradient(180deg, #202021, #0d0d0d);
        border-width: 1px;
        border-color: #ffffff18;

        // Toda la ventana se puede arrastrar. Los controles se declaran
        // después, así que quedan por encima y siguen recibiendo sus clics
        // con normalidad.
        WindowMoveArea { }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0;

            // El área central: los tres paneles se apilan en el mismo lugar
            // y `PanelSlot` deja visible solo el que está activo.
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // ── Controles ──
                PanelSlot {
                    active: root.active-panel == 0;

                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 6px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;

                            // Título y artista: la mitad izquierda de la fila.
                            VerticalLayout {
                                width: 50%;
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: root.track-title;
                                    color: root.has-session ? #f4f4f8 : #8d8d99;
                                    font-size: 14px;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.track-artist;
                                    color: #9a9aa6;
                                    font-size: 11px;
                                    overflow: elide;
                                }

                                // Selector de sesión: solo aparece cuando hay
                                // más de una.
                                if root.session-count > 1: HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 5px;
                                    padding-top: 5px;

                                    for session in root.sessions: SessionChip {
                                        label: session.label;
                                        selected: session.id == root.session-id;
                                        clicked => { root.select-session(session.id); }
                                    }
                                }
                            }

                            // Los controles, pegados al borde derecho.
                            HorizontalLayout {
                                alignment: end;
                                spacing: 4px;

                                IconButton {
                                    icon: @image-url("../assets/icons/replay_10.svg");
                                    active: root.has-session && root.can-seek;
                                    clicked => { root.seek-backward(); }
                                }

                                IconButton {
                                    icon: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play_arrow.svg");
                                    active: root.has-session && root.can-toggle;
                                    clicked => { root.toggle-play-pause(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/forward_10.svg");
                                    active: root.has-session && root.can-seek;
                                    clicked => { root.seek-forward(); }
                                }
                            }
                        }

                        // Línea de progreso: un slider para buscar posición, a
                        // lo ancho completo del panel.
                        Slider {
                            width: 100%;
                            height: 22px;
                            minimum: 0.0;
                            maximum: root.duration-secs * 1.0;
                            value: root.position-secs * 1.0;
                            enabled: root.has-session && root.can-seek;
                            released => { root.seek-to(self.value); }
                        }
                    }
                }

                // ── Conexión ──
                PanelSlot {
                    active: root.active-panel == 1;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 5px;
                        alignment: center;

                        // Tu sala: el código y el botón que lo copia.
                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                text: "Tu código";
                                width: 64px;
                                color: #7d7d89;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            code := CodeField {
                                text: root.room-code;
                                read-only: true;
                                font-size: 14px;
                                horizontal-alignment: center;
                                horizontal-stretch: 1;
                            }

                            IconButton {
                                icon: @image-url("../assets/icons/content_copy.svg");
                                icon-size: 15px;
                                width: 30px;
                                height: 30px;
                                flat: true;
                                clicked => { code.copy-text(); }
                            }
                        }

                        // La sala del otro equipo: se escribe y se conecta.
                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                text: "Otro equipo";
                                width: 64px;
                                color: #7d7d89;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            CodeField {
                                text <=> root.peer-room;
                                placeholder: "código";
                                horizontal-stretch: 1;
                                // Con Enter se conecta: no hace falta acertar
                                // el botón.
                                accepted => { root.connect(root.peer-room); }
                            }

                            ActionButton {
                                label: "Conectar";
                                clicked => { root.connect(root.peer-room); }
                            }
                        }

                        // El estado, con un punto que dice si hay canal, y la
                        // salida de la sala.
                        HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 5px;
                                height: 5px;
                                border-radius: 3px;
                                background: root.can-send ? #6ee7a8 : #5c5c66;
                            }

                            Text {
                                text: root.status-text;
                                color: #a9a9b6;
                                font-size: 11px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            IconButton {
                                icon: @image-url("../assets/icons/logout.svg");
                                icon-size: 14px;
                                width: 24px;
                                height: 24px;
                                flat: true;
                                clicked => { root.disconnect(); }
                            }
                        }
                    }
                }

                // ── Configuración (reservado) ──
                PanelSlot {
                    active: root.active-panel == 2;
                }
            }

            // La línea que separa el panel del menú.
            Rectangle {
                width: 1px;
                background: #ffffff14;
            }

            // El menú lateral: tres botones de ícono, apilados y del mismo
            // tamaño.
            Rectangle {
                width: 54px;

                // Tres botones de 30 px: con 112 px de alto, tres de 34 más
                // la separación no entran.
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 6px;
                    spacing: 4px;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../assets/icons/tune.svg");
                        icon-size: 17px;
                        width: 30px;
                        height: 30px;
                        selected: root.active-panel == 0;
                        tint: root.active-panel == 0 ? #a9a9ff : #f2f2f6;
                        clicked => { root.active-panel = 0; }
                    }

                    IconButton {
                        icon: @image-url("../assets/icons/link.svg");
                        icon-size: 17px;
                        width: 30px;
                        height: 30px;
                        selected: root.active-panel == 1;
                        tint: root.active-panel == 1 ? #a9a9ff : #f2f2f6;
                        clicked => { root.active-panel = 1; }
                    }

                    IconButton {
                        icon: @image-url("../assets/icons/settings.svg");
                        icon-size: 17px;
                        width: 30px;
                        height: 30px;
                        selected: root.active-panel == 2;
                        tint: root.active-panel == 2 ? #a9a9ff : #f2f2f6;
                        clicked => { root.active-panel = 2; }
                    }
                }
            }
        }
    }

    changed active-panel => { root.panel-changed(root.active-panel); }
}
